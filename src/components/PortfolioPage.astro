---
import Layout from '../layouts/Layout.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;
const t = getTranslations(lang);
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description} keywords={t.meta.keywords}>
    <a href="#main-content" class="skip-link">{t.nav.skip}</a>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <a href={lang === 'pt' ? '/' : `/${lang}`} class="text-lg font-extrabold text-slate-100 hover:text-indigo-400 transition-colors flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-indigo-500 inline-block animate-pulse"></span>
                Maicon Evangelista
            </a>
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
                <a href="#sobre" class="hover:text-indigo-400 transition-colors">{t.nav.about}</a>
                <a href="#competencias" class="hover:text-indigo-400 transition-colors">{t.nav.skills}</a>
                <a href="#projetos" class="hover:text-indigo-400 transition-colors">{t.nav.projects}</a>
                <a href="#experiencia" class="hover:text-indigo-400 transition-colors">{t.nav.experience}</a>
                <a href="#mentoria" class="hover:text-indigo-400 transition-colors">{t.nav.mentorship}</a>
                <a href="#artigos" class="hover:text-indigo-400 transition-colors">{t.nav.articles}</a>
            </nav>
            <div class="flex items-center gap-3">
                <LanguagePicker currentLang={lang} />
                <a href="mailto:maiconsi@hotmail.com" class="text-xs sm:text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white px-3.5 py-1.5 rounded-lg transition-all shadow-md shadow-indigo-600/20">
                    {t.nav.contact}
                </a>
            </div>
        </div>
    </header>

    <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-16 space-y-20">
        <!-- Hero Section -->
        <section class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-800/80 pb-16">
            <div class="md:col-span-7 space-y-6 text-center md:text-left">
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                        {t.hero.roleBadge}
                    </div>
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        {t.hero.statusBadge}
                    </div>
                </div>

                <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-100 tracking-tight leading-tight">
                    {t.hero.name} <span class="bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">{t.hero.nameHighlight}</span>
                </h1>

                <p class="text-lg font-medium text-slate-300">
                    {t.hero.subtitle}
                </p>

                <p class="text-slate-400 leading-relaxed text-sm sm:text-base max-w-2xl">
                    {t.hero.bio}
                </p>

                <div class="flex flex-wrap justify-center md:justify-start gap-3 pt-2">
                    <a href="https://www.linkedin.com/in/maiconsi/" target="_blank" rel="noopener noreferrer" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-2 rounded-xl text-sm transition-all shadow-lg shadow-indigo-600/25">{t.hero.linkedin}</a>
                    <a href="https://github.com/maiconsi" target="_blank" rel="noopener noreferrer" class="bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold px-4 py-2 rounded-xl text-sm transition-all">{t.hero.github}</a>
                    <a href="mailto:maiconsi@hotmail.com" class="bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700/80 font-semibold px-4 py-2 rounded-xl text-sm transition-all">{t.hero.email}</a>
                </div>
            </div>

            <div class="md:col-span-5 flex justify-center">
                <div class="relative group">
                    <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-indigo-500 to-cyan-500 opacity-30 group-hover:opacity-60 blur-lg transition duration-500"></div>
                    <img 
                        src="/Profile_Photo.png" 
                        alt="Maicon da Silva Evangelista" 
                        width="2208" 
                        height="2944" 
                        loading="eager" 
                        decoding="async" 
                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=500&auto=format&fit=crop&q=80';" 
                        class="relative w-48 h-48 sm:w-56 sm:h-56 lg:w-64 lg:h-64 rounded-full border-2 border-slate-800 ring-2 ring-indigo-500/50 shadow-2xl shadow-indigo-500/10 object-cover object-center transition-all duration-300 group-hover:scale-[1.02]" 
                    />
                </div>
            </div>
        </section>

        <!-- Tech Badges Section: Destaque de Competências -->
        <section id="competencias" class="space-y-6">
            <div class="text-center md:text-left space-y-1">
                <h2 class="text-xs font-bold uppercase tracking-widest text-indigo-400">{t.techBadges.tag}</h2>
                <p class="text-xl font-bold text-slate-100">{t.techBadges.title}</p>
            </div>

            <div class="flex flex-wrap gap-3 items-center justify-center md:justify-start">
                {t.techBadges.items.map((badge, idx) => {
                    const colors = [
                        "bg-indigo-400",
                        "bg-cyan-400",
                        "bg-emerald-400",
                        "bg-purple-400",
                        "bg-amber-400",
                        "bg-blue-400",
                        "bg-sky-400"
                    ];
                    const color = colors[idx % colors.length];
                    return (
                        <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                            <span class={`w-2 h-2 rounded-full ${color} group-hover:scale-125 transition-transform`}></span>
                            {badge}
                        </span>
                    );
                })}
            </div>
        </section>

        <!-- Sobre Mim / Resumo Profissional -->
        <section id="sobre" class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-sm space-y-4 shadow-xl">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">{t.about.title}</h2>
            </div>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
                {t.about.p1}
            </p>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
                {t.about.p2}
            </p>
        </section>

        <!-- Principais Competências Técnico-Operacionais -->
        <section class="space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">{t.skills.title}</h2>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 001-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                        {t.skills.cloud.title}
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">{t.skills.cloud.desc}</p>
                </div>
                
                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        {t.skills.devops.title}
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">{t.skills.devops.desc}</p>
                </div>

                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        {t.skills.sre.title}
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">{t.skills.sre.desc}</p>
                </div>

                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        {t.skills.leadership.title}
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">{t.skills.leadership.desc}</p>
                </div>
            </div>
        </section>

        <!-- Seção de Projetos em Destaque -->
        <section id="projetos" class="space-y-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                    <h2 class="text-2xl font-bold text-slate-100">{t.projects.title}</h2>
                </div>
                <span class="text-xs font-semibold text-slate-400">{t.projects.tag}</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Projeto 1 -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="aspect-[16/9] w-full bg-slate-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 flex items-center justify-center p-6 text-center">
                                <svg class="w-12 h-12 text-indigo-400/80 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            </div>
                            <span class="absolute top-3 left-3 bg-indigo-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                                {t.projects.p1.category}
                            </span>
                        </div>
                        <div class="p-5 space-y-3">
                            <h3 class="font-bold text-slate-100 group-hover:text-indigo-400 transition-colors text-base">
                                {t.projects.p1.title}
                            </h3>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                {t.projects.p1.desc}
                            </p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2 flex flex-wrap gap-1.5">
                        {t.projects.p1.tags.map(tag => (
                            <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">{tag}</span>
                        ))}
                    </div>
                </div>

                <!-- Projeto 2 -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="aspect-[16/9] w-full bg-slate-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-cyan-950 via-slate-900 to-slate-950 flex items-center justify-center p-6 text-center">
                                <svg class="w-12 h-12 text-cyan-400/80 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                            </div>
                            <span class="absolute top-3 left-3 bg-cyan-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                                {t.projects.p2.category}
                            </span>
                        </div>
                        <div class="p-5 space-y-3">
                            <h3 class="font-bold text-slate-100 group-hover:text-indigo-400 transition-colors text-base">
                                {t.projects.p2.title}
                            </h3>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                {t.projects.p2.desc}
                            </p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2 flex flex-wrap gap-1.5">
                        {t.projects.p2.tags.map(tag => (
                            <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">{tag}</span>
                        ))}
                    </div>
                </div>
                <!-- Projeto 3 -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="aspect-[16/9] w-full bg-slate-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 flex items-center justify-center p-6 text-center">
                                <svg class="w-12 h-12 text-emerald-400/80 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            </div>
                            <span class="absolute top-3 left-3 bg-emerald-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                                {t.projects.p3.category}
                            </span>
                        </div>
                        <div class="p-5 space-y-3">
                            <h3 class="font-bold text-slate-100 group-hover:text-indigo-400 transition-colors text-base">
                                {t.projects.p3.title}
                            </h3>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                {t.projects.p3.desc}
                            </p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2 flex flex-wrap gap-1.5">
                        {t.projects.p3.tags.map(tag => (
                            <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">{tag}</span>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Trajetória Profissional em Destaque -->
        <section id="experiencia" class="space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">{t.experience.title}</h2>
            </div>
            
            <div class="space-y-6">
                <!-- Posição 1 -->
                <div class="border-l-2 border-indigo-500 pl-4 py-2 bg-slate-900/40 rounded-r-xl p-4 border-t border-r border-b border-slate-800/80 space-y-2">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
                        <h3 class="text-lg font-bold text-slate-100">{t.experience.role1.title}</h3>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 w-max">
                            {t.experience.role1.company}
                        </span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                        {t.experience.role1.desc}
                    </p>
                </div>

                <!-- Posição 2 -->
                <div class="border-l-2 border-slate-700 pl-4 py-2 bg-slate-900/40 rounded-r-xl p-4 border-t border-r border-b border-slate-800/80 space-y-2">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
                        <h3 class="text-lg font-bold text-slate-100">{t.experience.role2.title}</h3>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 w-max">
                            {t.experience.role2.company}
                        </span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                        {t.experience.role2.desc}
                    </p>
                </div>
            </div>
        </section>

        <!-- Seção de Mentoria Social Gratuita -->
        <section id="mentoria" class="space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-emerald-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">{t.mentorship.sectionTitle}</h2>
            </div>

            <div class="bg-slate-800/80 border border-indigo-500/30 rounded-2xl p-6 md:p-8 backdrop-blur-sm relative overflow-hidden shadow-xl grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <!-- Coluna de Imagem / Flyer com Preview Interativo -->
                <div class="md:col-span-5 relative group order-2 md:order-1">
                    <button 
                        type="button" 
                        id="open-mentoria-modal" 
                        class="relative block w-full overflow-hidden rounded-xl border border-slate-700/50 shadow-md group cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-400 text-left"
                        aria-label={t.mentorship.zoomText}
                    >
                        <img 
                            src="/mentoria.png" 
                            alt={t.mentorship.imageAlt}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-auto object-cover rounded-xl transition-all duration-300 group-hover:scale-[1.03]"
                        />
                        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center text-white font-medium text-xs sm:text-sm backdrop-blur-[2px]">
                            <span class="bg-slate-900/90 border border-slate-700 px-3.5 py-1.5 rounded-full flex items-center gap-2 shadow-xl text-slate-200">
                                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                                {t.mentorship.zoomText}
                            </span>
                        </div>
                    </button>
                </div>

                <!-- Coluna de Conteúdo & CTA -->
                <div class="md:col-span-7 space-y-5 order-1 md:order-2">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        {t.mentorship.badge}
                    </div>

                    <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-100 tracking-tight leading-snug">
                        {t.mentorship.title}
                    </h3>

                    <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
                        {t.mentorship.desc}
                    </p>

                    <div class="pt-2">
                        <a 
                            href="https://app.sessaomentoria.com.br/u/maicon-da-silva-evangelista" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-6 py-3 rounded-xl transition-all duration-300 shadow-lg shadow-emerald-900/30 inline-flex items-center gap-2 group"
                            aria-label={t.mentorship.cta}
                        >
                            <span>{t.mentorship.cta}</span>
                            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                    </div>
                </div>
            </div>
            <!-- Modal Lightbox -->
            <dialog 
                id="mentoria-modal" 
                class="backdrop:bg-slate-950/85 backdrop:backdrop-blur-md bg-transparent p-4 max-w-5xl w-full m-auto open:flex open:flex-col items-center justify-center focus:outline-none border-none overflow-visible z-50"
                aria-label={t.mentorship.imageEnlargedAlt}
            >
                <div class="relative max-w-3xl w-full flex flex-col items-center">
                    <button 
                        type="button" 
                        id="close-mentoria-modal" 
                        class="self-end mb-2 text-slate-300 hover:text-white bg-slate-800/90 hover:bg-slate-700 border border-slate-700 rounded-full p-2.5 transition-all shadow-xl cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-400"
                        aria-label="Fechar"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                    <div class="rounded-2xl overflow-hidden border border-slate-700/80 shadow-2xl bg-slate-900 max-h-[82vh] flex items-center justify-center">
                        <img 
                            src="/mentoria.png" 
                            alt={t.mentorship.imageEnlargedAlt} 
                            class="max-h-[80vh] w-auto max-w-full object-contain mx-auto"
                        />
                    </div>
                    <p class="text-xs text-slate-400 mt-3 text-center">{t.mentorship.escText}</p>
                </div>
            </dialog>

            <script is:inline>
                const openBtn = document.getElementById('open-mentoria-modal');
                const closeBtn = document.getElementById('close-mentoria-modal');
                const modal = document.getElementById('mentoria-modal');
                if (openBtn && modal) {
                    openBtn.addEventListener('click', () => {
                        modal.showModal();
                        document.body.classList.add('overflow-hidden');
                    });
                }
                const closeModal = () => {
                    if (modal && modal.open) {
                        modal.close();
                        document.body.classList.remove('overflow-hidden');
                    }
                };
                if (closeBtn) closeBtn.addEventListener('click', closeModal);
                if (modal) {
                    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
                    modal.addEventListener('close', () => { document.body.classList.remove('overflow-hidden'); });
                }
            </script>

