---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Link de Acessibilidade -->
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <a href="#" class="text-lg font-extrabold text-slate-100 hover:text-indigo-400 transition-colors flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-indigo-500 inline-block animate-pulse"></span>
                Maicon Evangelista
            </a>
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
                <a href="#sobre" class="hover:text-indigo-400 transition-colors">Sobre</a>
                <a href="#competencias" class="hover:text-indigo-400 transition-colors">Competências</a>
                <a href="#projetos" class="hover:text-indigo-400 transition-colors">Projetos</a>
                <a href="#experiencia" class="hover:text-indigo-400 transition-colors">Experiência</a>
                <a href="#mentoria" class="hover:text-indigo-400 transition-colors">Mentoria</a>
                <a href="#artigos" class="hover:text-indigo-400 transition-colors">Artigos</a>
            </nav>
            <div class="flex items-center gap-3">
                <a 
                    href="mailto:maiconsi@hotmail.com" 
                    class="text-xs sm:text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white px-3.5 py-1.5 rounded-lg transition-all shadow-md shadow-indigo-600/20"
                    aria-label="Entrar em contato via e-mail"
                >
                    Contato
                </a>
            </div>
        </div>
    </header>

    <!-- Container Principal -->
    <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-16 space-y-20">
        
        <!-- Hero Section: Layout em Grid/Flex de dois blocos -->
        <section class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center border-b border-slate-800/80 pb-16">
            <!-- Bloco 1: Apresentação Executiva -->
            <div class="md:col-span-7 space-y-6 text-center md:text-left">
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                        Senior Cloud Architect & SRE Specialist
                    </div>
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Disponível para Novas Oportunidades
                    </div>
                </div>

                <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-100 tracking-tight leading-tight">
                    Maicon da Silva <span class="bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">Evangelista</span>
                </h1>

                <p class="text-lg font-medium text-slate-300">
                    Senior Cloud Architect & SRE Specialist | Lead Solution Consultant
                </p>

                <p class="text-slate-400 leading-relaxed text-sm sm:text-base max-w-2xl">
                    Com mais de 26 anos de experiência em Engenharia de Software e Infraestrutura, atuo na concepção, migração e sustentação de arquiteturas distribuídas e plataformas resilientes de missão crítica em nuvem.
                </p>

                <!-- Botoes de Ação / Redes Sociais -->
                <div class="flex flex-wrap justify-center md:justify-start gap-3 pt-2">
                    <a href="https://www.linkedin.com/in/maiconsi/" target="_blank" rel="noopener noreferrer" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-2 rounded-xl text-sm transition-all shadow-lg shadow-indigo-600/25" aria-label="Acessar perfil no LinkedIn (abre em nova aba)">LinkedIn</a>
                    <a href="https://github.com/maiconsi" target="_blank" rel="noopener noreferrer" class="bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold px-4 py-2 rounded-xl text-sm transition-all" aria-label="Acessar perfil no GitHub (abre em nova aba)">GitHub</a>
                    <a href="mailto:maiconsi@hotmail.com" class="bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700/80 font-semibold px-4 py-2 rounded-xl text-sm transition-all" aria-label="Enviar e-mail para Maicon da Silva Evangelista">E-mail</a>
                </div>
            </div>

            <!-- Bloco 2: Avatar Profissional -->
            <div class="md:col-span-5 flex justify-center">
                <div class="relative group">
                    <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-indigo-500 to-cyan-500 opacity-30 group-hover:opacity-60 blur-lg transition duration-500"></div>
                    <img 
                        src="/Profile_Photo.png" 
                        alt="Foto de perfil profissional de Maicon da Silva Evangelista" 
                        width="2208"
                        height="2944"
                        loading="eager"
                        decoding="async"
                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=500&auto=format&fit=crop&q=80';"
                        class="relative w-48 h-48 sm:w-56 sm:h-56 lg:w-64 lg:h-64 rounded-full border-2 border-slate-800 ring-2 ring-indigo-500/50 shadow-2xl shadow-indigo-500/10 object-cover object-center transition-all duration-300 group-hover:scale-[1.02]"
                    >
                </div>
            </div>
        </section>


        <!-- Tech Badges Section: Destaque de Competências -->
        <section id="competencias" class="space-y-6">
            <div class="text-center md:text-left space-y-1">
                <h2 class="text-xs font-bold uppercase tracking-widest text-indigo-400">Ecossistema Técnico</h2>
                <p class="text-xl font-bold text-slate-100">Principais Competências em Destaque</p>
            </div>

            <div class="flex flex-wrap gap-3 items-center justify-center md:justify-start">
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-indigo-400 group-hover:scale-125 transition-transform"></span>
                    Cloud Architecture
                </span>
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 group-hover:scale-125 transition-transform"></span>
                    SRE
                </span>
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 group-hover:scale-125 transition-transform"></span>
                    DevOps
                </span>
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-purple-400 group-hover:scale-125 transition-transform"></span>
                    Observabilidade
                </span>
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-amber-400 group-hover:scale-125 transition-transform"></span>
                    CI/CD
                </span>
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-blue-400 group-hover:scale-125 transition-transform"></span>
                    Terraform
                </span>
                <span class="bg-slate-800/60 border border-slate-700/50 backdrop-blur-sm hover:border-indigo-500/50 transition-all text-slate-200 text-xs sm:text-sm font-medium px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm group">
                    <span class="w-2 h-2 rounded-full bg-sky-400 group-hover:scale-125 transition-transform"></span>
                    Kubernetes
                </span>
            </div>
        </section>

        <!-- Sobre Mim / Resumo Profissional -->
        <section id="sobre" class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-sm space-y-4 shadow-xl">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">Sobre Mim</h2>
            </div>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
                Com mais de 26 anos de experiência consolidada em Engenharia de Software e Infraestrutura, atuo na concepção, migração e sustentação de arquiteturas distribuídas e plataformas resilientes de missão crítica. Especializado em ecossistemas Cloud Native (AWS), automação de infraestrutura como código (IaC), orquestração de microsserviços e implementação da cultura SRE e DevOps.
            </p>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
                Minha trajetória abrange desde o desenvolvimento e modernização de aplicações legadas até a liderança técnica em projetos de transformação digital de alta complexidade. Atualmente, foco na interseção entre resiliência operacional, eficiência de custos em nuvem (FinOps) e observabilidade avançada, preparando-me para iniciar especialização acadêmica em inteligência artificial aplicada a operações de TI (AIOps).
            </p>
        </section>

        <!-- Principais Competências Técnico-Operacionais -->
        <section class="space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">Especialidades e Habilidades</h2>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 001-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                        Cloud & Infraestrutura
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">AWS (EKS, EC2, S3, IAM, VPC), Cloud Architecture, High Availability, Disaster Recovery, FinOps.</p>
                </div>
                
                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        DevOps & Automação (IaC)
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">Terraform, Ansible, GitHub Actions, Jenkins, CI/CD Pipelines, GitOps, Shell Scripting.</p>
                </div>

                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        SRE & Observabilidade
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">Kubernetes, Docker, Prometheus, Grafana, Datadog, SLIs/SLOs, Incident Management, Observabilidade Contínua.</p>
                </div>

                <div class="bg-slate-900/50 p-5 rounded-xl border border-slate-800 hover:border-slate-700/80 transition-colors space-y-2">
                    <h3 class="font-semibold text-indigo-300 flex items-center gap-2 text-base">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        Liderança & Metodologias
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">Consultoria Técnica de Soluções, Agile/Scrum, Mentoria Tech, Arquitetura de Software.</p>
                </div>
            </div>
        </section>

        <!-- Seção de Projetos em Destaque -->
        <section id="projetos" class="space-y-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                    <h2 class="text-2xl font-bold text-slate-100">Projetos em Destaque</h2>
                </div>
                <span class="text-xs font-semibold text-slate-400">Cases Arquiteturais</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Projeto 1 -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="aspect-[16/9] w-full bg-slate-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 flex items-center justify-center p-6 text-center">
                                <svg class="w-12 h-12 text-indigo-400/80 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            </div>
                            <span class="absolute top-3 left-3 bg-indigo-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                                Observabilidade & SRE
                            </span>
                        </div>
                        <div class="p-5 space-y-3">
                            <h3 class="font-bold text-slate-100 group-hover:text-indigo-400 transition-colors text-base">
                                Plataforma de Observabilidade e Telemetria em Kubernetes
                            </h3>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Arquitetura e implementação de ecossistema de observabilidade distribuída com Prometheus, Grafana e métricas para redução proativa de MTTR.
                            </p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2 flex flex-wrap gap-1.5">
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">Kubernetes</span>
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">Prometheus</span>
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">Grafana</span>
                    </div>
                </div>

                <!-- Projeto 2 -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="aspect-[16/9] w-full bg-slate-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-cyan-950 via-slate-900 to-slate-950 flex items-center justify-center p-6 text-center">
                                <svg class="w-12 h-12 text-cyan-400/80 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                            </div>
                            <span class="absolute top-3 left-3 bg-cyan-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                                Cloud Architecture
                            </span>
                        </div>
                        <div class="p-5 space-y-3">
                            <h3 class="font-bold text-slate-100 group-hover:text-indigo-400 transition-colors text-base">
                                Infraestrutura como Código Multi-Cloud & FinOps
                            </h3>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Padronização de módulos Terraform reutilizáveis para provisionamento automatizado AWS EKS, VPC e governança contínua de custos FinOps.
                            </p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2 flex flex-wrap gap-1.5">
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">AWS</span>
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">Terraform</span>
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">FinOps</span>
                    </div>
                </div>

                <!-- Projeto 3 -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <div class="aspect-[16/9] w-full bg-slate-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 flex items-center justify-center p-6 text-center">
                                <svg class="w-12 h-12 text-emerald-400/80 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            </div>
                            <span class="absolute top-3 left-3 bg-emerald-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                                DevOps & GitOps
                            </span>
                        </div>
                        <div class="p-5 space-y-3">
                            <h3 class="font-bold text-slate-100 group-hover:text-indigo-400 transition-colors text-base">
                                Pipeline CI/CD GitOps com GitHub Actions & ArgoCD
                            </h3>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Automação de esteiras de integração e entrega contínua com validações de segurança, testes estáticos de código e deploy declarativo em Kubernetes.
                            </p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2 flex flex-wrap gap-1.5">
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">GitHub Actions</span>
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">ArgoCD</span>
                        <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2 py-0.5 rounded">GitOps</span>
                    </div>
                </div>
            </div>
        </section>


        <!-- Trajetória Profissional em Destaque -->
        <section id="experiencia" class="space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-1 h-6 bg-indigo-500 rounded-full"></div>
                <h2 class="text-2xl font-bold text-slate-100">Experiência Profissional Recente</h2>
            </div>
            
            <div class="space-y-6">
                <!-- Posição 1 -->
                <div class="border-l-2 border-indigo-500 pl-4 py-2 bg-slate-900/40 rounded-r-xl p-4 border-t border-r border-b border-slate-800/80 space-y-2">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
                        <h3 class="text-lg font-bold text-slate-100">Lead Solution Consultant / Cloud Architect</h3>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 w-max">
                            FICO | Atuação Recente
                        </span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                        Liderança na arquitetura e implementação de soluções de tomada de decisão e análise preditiva na nuvem. Responsável por desenhar ambientes escaláveis e seguros para grandes clientes corporativos, garantindo governança, alta disponibilidade e otimização de custos em ecossistemas AWS.
                    </p>
                </div>

                <!-- Posição 2 -->
                <div class="border-l-2 border-slate-700 pl-4 py-2 bg-slate-900/40 rounded-r-xl p-4 border-t border-r border-b border-slate-800/80 space-y-2">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
                        <h3 class="text-lg font-bold text-slate-100">Senior Specialist Systems Engineer</h3>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 w-max">
                            Atuações Anteriores
                        </span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                        Atuação em engenharia de sistemas de missão crítica, liderando iniciativas de automação de infraestrutura, padronização de pipelines de entrega contínua (CI/CD) e estruturação de monitoramento de observabilidade ponta a ponta.
                    </p>
                </div>
