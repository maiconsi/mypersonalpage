---
import '../styles/global.css';
import type { Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  lang?: Lang;
}

const { 
  lang = 'pt',
  title = "Maicon da Silva Evangelista | Senior Cloud Architect & SRE", 
  description = "Portfólio profissional e blog de Maicon da Silva Evangelista. Especialista em Arquitetura Cloud (AWS), DevOps, SRE, Kubernetes e automação de plataformas de missão crítica.",
  keywords = "Maicon da Silva Evangelista, Cloud Architect, SRE, DevOps, AWS, Kubernetes, Terraform, Observabilidade, FinOps, Engenharia de Software, Astro, GitHub Pages",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://maiconevangelista.com.br');
const ogImageURL = new URL(image, Astro.site || 'https://maiconevangelista.com.br');

const htmlLang = lang === 'pt' ? 'pt-BR' : lang;
const ogLocale = lang === 'pt' ? 'pt_BR' : lang === 'es' ? 'es_ES' : 'en_US';
const siteOrigin = 'https://maiconevangelista.com.br';
---

<!DOCTYPE html>
<html lang={htmlLang} class="scroll-smooth">
<head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JJYZJN1M5C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JJYZJN1M5C');
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    
    <!-- Meta Tags Principais -->
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <meta name="author" content="Maicon da Silva Evangelista">
    <meta name="robots" content="index, follow">
    <meta name="google-site-verification" content="faF2LhrGH1LmcuiYtLprM2IamgSnN2luXZbg4vj56V8" />
    <link rel="canonical" href={canonicalURL.href}>

    <!-- Hreflang Tags de Internacionalização -->
    <link rel="alternate" hreflang="pt" href={`${siteOrigin}/`}>
    <link rel="alternate" hreflang="en" href={`${siteOrigin}/en`}>
    <link rel="alternate" hreflang="es" href={`${siteOrigin}/es`}>
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`}>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL.href}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageURL.href}>
    <meta property="og:locale" content={ogLocale}>

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={canonicalURL.href}>
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content={ogImageURL.href}>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Dados Estruturados (Schema.org - Person & ProfilePage) -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://maiconevangelista.com.br/#person",
          "name": "Maicon da Silva Evangelista",
          "url": "https://maiconevangelista.com.br",
          "jobTitle": "Senior Cloud Architect & SRE Specialist",
          "sameAs": [
            "https://www.linkedin.com/in/maiconsi/",
            "https://github.com/maiconsi"
          ],
          "knowsAbout": [
            "Cloud Architecture",
            "AWS",
            "DevOps",
            "Site Reliability Engineering (SRE)",
            "Kubernetes",
            "Terraform",
            "Observability",
            "FinOps",
            "CI/CD"
          ]
        },
        {
          "@type": "ProfilePage",
          "@id": "https://maiconevangelista.com.br/#webpage",
          "url": "https://maiconevangelista.com.br",
          "name": "Maicon da Silva Evangelista | Senior Cloud Architect & SRE",
          "isPartOf": {
            "@type": "WebSite",
            "name": "Maicon da Silva Evangelista",
            "url": "https://maiconevangelista.com.br"
          },
          "mainEntity": {
            "@id": "https://maiconevangelista.com.br/#person"
          }
        }
      ]
    }
    </script>
</head>
<body class="bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white min-h-screen flex flex-col font-sans">
    <slot />
</body>
</html>

