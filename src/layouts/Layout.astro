---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Maicon da Silva Evangelista | Senior Cloud Architect & SRE", 
  description = "Portfólio profissional e blog de Maicon da Silva Evangelista. Especialista em Arquitetura Cloud (AWS), DevOps, SRE, Kubernetes e automação de plataformas de missão crítica." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    
    <!-- Meta Tags Principais -->
    <meta name="description" content={description}>
    <meta name="keywords" content="Maicon da Silva Evangelista, Cloud Architect, SRE, DevOps, AWS, Kubernetes, Terraform, AIOps, Engenharia de Software">
    <meta name="author" content="Maicon da Silva Evangelista">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://maiconevangelista.com.br/">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://maiconevangelista.com.br/">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://maiconevangelista.com.br/assets/og-image.png">
    <meta property="og:locale" content="pt_BR">

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://maiconevangelista.com.br/">
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content="https://maiconevangelista.com.br/assets/og-image.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Dados Estruturados (Schema.org - Person) -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Maicon da Silva Evangelista",
      "url": "https://maiconevangelista.com.br",
      "jobTitle": "Lead Solution Consultant & Cloud Architect",
      "worksFor": {
        "@type": "Organization",
        "name": "FICO"
      },
      "sameAs": [
        "https://www.linkedin.com/in/maiconsi/",
        "https://github.com/maiconsi"
      ],
      "knowsAbout": [
        "Cloud Computing",
        "AWS",
        "DevOps",
        "Site Reliability Engineering",
        "Kubernetes",
        "Terraform",
        "AIOps"
      ]
    }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-blue-500 selection:text-white">
    <slot />
</body>
</html>
