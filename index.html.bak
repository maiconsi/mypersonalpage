    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: #0f172a;
            color: white;
            padding: 8px;
            z-index: 100;
            transition: top 0.3s;
        }
        .skip-link:focus {
            top: 0;
        }
    </style>

    <!-- Dados Estruturados (Schema.org - Person) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Maicon da Silva Evangelista",
      "url": "https://maiconevangelista.com.br",
      "jobTitle": "Lead Solution Consultant & Cloud Architect",
      "worksFor": {
        "@type": "Organization",
        "name": "FICO"
      },
